# --- Application ---
APP_NAME=CampusPilot AI
API_V1_PREFIX=/api/v1
ENVIRONMENT=development

# --- Database (PostgreSQL) ---
# Example: postgresql+psycopg2://campuspilot:campuspilot@localhost:5432/campuspilot
DATABASE_URL=postgresql+psycopg2://campuspilot:campuspilot@localhost:5432/campuspilot

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS ---
# Comma separated list of allowed origins.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# --- Uploads ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=10485760

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Attendance ---
ATTENDANCE_THRESHOLD=75

# --- AI Provider ---
# ai_provider options: "mock" (no external service, deterministic) or "openai"
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# --- OCR ---
TESSERACT_CMD=

# --- Logging ---
LOG_LEVEL=INFO
